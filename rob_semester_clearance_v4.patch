+def test_frame_for_tangent_is_proper_pose():
+    pose = _frame_for_tangent(
+        np.array([0., 0., -1.]), np.array([.4, .1, .2]),
+        np.array([0., 0.]), None,
+    )
+    np.testing.assert_allclose(pose[:3, 2], [0, 0, 1])
+    assert np.linalg.det(pose[:3, :3]) == pytest.approx(1)
