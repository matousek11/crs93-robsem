-"""Planar rotations about the vertical axis.
+"""Coordinate transformations between the plate and robot frames.
 
-Positive angles are counterclockwise when viewed from above, the same
-sense as a plate heading. Angle 0 leaves the x axis in place. A positive
-quarter turn maps it onto the y axis.
-
-A point (x, y) rotated about the origin by angle is
-(cosine * x - sine * y, sine * x + cosine * y).
+Positive plate heading is counterclockwise when viewed from above. The
+plate x axis at heading zero is aligned with the robot x axis.
 """
 
+from __future__ import annotations
+
 import math
+from typing import TYPE_CHECKING
+
+import numpy as np
+
+from hoop_guide.types import Directions3D
+from hoop_guide.types import PlateDirections3D
+from hoop_guide.types import PlatePoints3D
+from hoop_guide.types import Points3D
+
+if TYPE_CHECKING:
+    from hoop_guide.plate import PlatePose
 
 
 def get_cosine_and_sine(angle: float) -> tuple[float, float]:
@@ -21,3 +30,55 @@ def get_cosine_and_sine(angle: float) -> tuple[float, float]:
         Cosine and sine of angle.
     """
     return math.cos(angle), math.sin(angle)
+
+
+def rod_to_robot_frame(
+    points_plate: PlatePoints3D,
+    tangents_plate: PlateDirections3D,
+    plate: PlatePose,
+    plate_height: float,
+) -> tuple[Points3D, Directions3D]:
+    """Transforms rod points and unit tangents from the plate to robot frame.
+
+    Args:
+        points_plate: Rod centerline in the plate frame, shape (N, 3) [m].
+        tangents_plate: Unit tangents in the plate frame, shape (N, 3).
+        plate: Plate center x, y and heading in the robot frame.
+        plate_height: Height of the plate top above the robot base [m].
+
+    Returns:
+        Rod centerline and unit tangents in the robot frame, shape (N, 3).
+
+    Raises:
+        ValueError: Input shapes or values are invalid.
+    """
+    if (
+        points_plate.ndim != 2
+        or points_plate.shape[1] != 3
+        or points_plate.shape != tangents_plate.shape
+        or len(points_plate) == 0
+    ):
+        raise ValueError(
+            "Points and tangents must have matching (N, 3) shapes."
+        )
+    if not (
+        np.isfinite(points_plate).all()
+        and np.isfinite(tangents_plate).all()
+        and all(
+            math.isfinite(value)
+            for value in (plate.x, plate.y, plate.heading, plate_height)
+        )
+    ):
+        raise ValueError("Rod points, tangents and plate pose must be finite.")
+    if not np.allclose(np.linalg.norm(tangents_plate, axis=1), 1.0):
+        raise ValueError("Rod tangents must have unit length.")
+
+    cosine, sine = get_cosine_and_sine(plate.heading)
+    rotation = np.array(
+        [[cosine, -sine, 0.0], [sine, cosine, 0.0], [0.0, 0.0, 1.0]]
+    )
+    translation = np.array([plate.x, plate.y, plate_height])
+    return (
+        Points3D(points_plate @ rotation.T + translation),
+        Directions3D(tangents_plate @ rotation.T),
+    )
