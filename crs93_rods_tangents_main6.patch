+import math
+
+import numpy as np
+import pytest
+
+from hoop_guide.rods import Puzzle
+from hoop_guide.rods import rod_centerline
+
+
+@pytest.mark.parametrize("puzzle", [Puzzle.A1, Puzzle.A2, Puzzle.B, Puzzle.C])
+def test_rod_samples_have_matching_shapes_and_unit_tangents(puzzle):
+    points, tangents = rod_centerline(puzzle, step=0.005)
+
+    assert points.shape == tangents.shape
+    assert points.ndim == 2
+    assert points.shape[1] == 3
+    np.testing.assert_allclose(np.linalg.norm(tangents, axis=1), 1.0)
+
+
+def test_a1_has_vertical_centerline_from_free_tip_to_plate():
+    points, tangents = rod_centerline(Puzzle.A1)
+
+    np.testing.assert_allclose(points[0], [0.0, 0.0, 0.2])
+    np.testing.assert_allclose(points[-1], [0.0, 0.0, 0.0])
+    np.testing.assert_allclose(points[:, :2], 0.0)
+    np.testing.assert_allclose(tangents, np.tile([0.0, 0.0, -1.0], (41, 1)))
+
+
+def test_a1_and_a2_have_identical_shapes():
+    points_a1, tangents_a1 = rod_centerline(Puzzle.A1)
+    points_a2, tangents_a2 = rod_centerline(Puzzle.A2)
+
+    np.testing.assert_allclose(points_a1, points_a2)
+    np.testing.assert_allclose(tangents_a1, tangents_a2)
+
+
+@pytest.mark.parametrize(
+    ("puzzle", "vertices"),
+    [
+        (
+            Puzzle.B,
+            [
+                [0.07, 0.0, 0.2],
+                [0.07, 0.0, 0.15],
+                [0.0, 0.0, 0.08],
+                [0.0, 0.0, 0.0],
+            ],
+        ),
+        (
+            Puzzle.C,
+            [
+                [-0.05, -0.05, 0.2],
+                [-0.05, -0.05, 0.15],
+                [-0.05, 0.0, 0.10],
+                [0.0, 0.0, 0.05],
+                [0.0, 0.0, 0.0],
+            ],
+        ),
+    ],
+)
+def test_b_and_c_include_each_bend_once(puzzle, vertices):
+    points, _ = rod_centerline(puzzle, step=0.003)
+
+    for vertex in vertices:
+        occurrences = np.count_nonzero(
+            np.all(np.isclose(points, vertex, atol=1e-12), axis=1)
+        )
+        assert occurrences == 1
+
+
+@pytest.mark.parametrize("puzzle", [Puzzle.A1, Puzzle.A2, Puzzle.B, Puzzle.C])
+def test_sampling_step_is_an_upper_bound(puzzle):
+    points, _ = rod_centerline(puzzle, step=0.007)
+
+    distances = np.linalg.norm(np.diff(points, axis=0), axis=1)
+    assert np.all(distances > 0)
+    assert np.all(distances <= 0.007 + 1e-12)
+
+
+@pytest.mark.parametrize("puzzle", [Puzzle.A1, Puzzle.B, Puzzle.C])
+def test_each_tangent_follows_the_next_sample(puzzle):
+    points, tangents = rod_centerline(puzzle, step=0.007)
+    displacements = np.diff(points, axis=0)
+    displacement_units = displacements / np.linalg.norm(
+        displacements, axis=1, keepdims=True
+    )
+
+    np.testing.assert_allclose(tangents[:-1], displacement_units, atol=1e-12)
+    np.testing.assert_allclose(tangents[-1], displacement_units[-1], atol=1e-12)
+
+
+def test_b_has_correct_outgoing_tangent_at_first_bend():
+    points, tangents = rod_centerline(Puzzle.B)
+    bend_index = np.flatnonzero(np.isclose(points[:, 2], 0.15))[0]
+
+    expected = np.array([-1.0, 0.0, -1.0]) / math.sqrt(2.0)
+    np.testing.assert_allclose(tangents[bend_index], expected)
+    np.testing.assert_allclose(tangents[bend_index - 1], [0.0, 0.0, -1.0])
+
+
+@pytest.mark.parametrize("step", [0.0, -0.01, float("inf"), float("nan")])
+def test_invalid_sampling_step_is_rejected(step):
+    with pytest.raises(ValueError, match="Sampling step"):
+        rod_centerline(Puzzle.A1, step=step)
+
+
+def test_d_is_explicitly_not_implemented():
+    with pytest.raises(NotImplementedError, match="D"):
+        rod_centerline(Puzzle.D)
