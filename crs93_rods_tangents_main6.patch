+)
+
+_ROD_VERTICES: dict[Puzzle, tuple[tuple[float, float, float], ...]] = {
+    Puzzle.A1: _STRAIGHT_VERTICES,
+    Puzzle.A2: _STRAIGHT_VERTICES,
+    Puzzle.B: (
