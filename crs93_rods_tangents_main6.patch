 def rod_centerline(
-    puzzle: Puzzle, plate: PlatePose, plate_height: float, step: float
-) -> tuple[Points3D, Directions3D]:
-    """Samples the rod centerline in the robot frame.
+    puzzle: Puzzle, step: float = 0.005
+) -> tuple[PlatePoints3D, PlateDirections3D]:
+    """Samples the full rod and its unit tangents in the plate frame.
 
-    The points go from the free end of the rod down to STOP_HEIGHT above the
-    plate, so they are the path of the hoop center.
+    Each bend is included once. The tangent at a bend follows the outgoing
+    segment, and the last tangent follows the final segment. These samples
+    describe the physical rod, not the final hoop path.
 
     Args:
-        puzzle: Which rod.
-        plate: Pose of the plate.
-        plate_height: Height of the plate top surface above the robot base
-            [m].
-        step: Distance between neighbouring points along the rod [m].
+        puzzle: Rod variant. D is not implemented yet.
+        step: Maximum distance between neighbouring samples [m].
 
     Returns:
-        Points, shape (N, 3), and unit tangents in them, shape (N, 3), both in
-        the robot frame. Tangents point along the path, from the free end
-        down.
+        Centerline points and unit tangents, both shape (N, 3), in the
+        plate frame. Points are in meters and tangents point toward the
+        rod mounting point.
+
+    Raises:
+        ValueError: The sampling step is not finite and positive.
+        NotImplementedError: The rod model is not available yet.
     """
-    raise NotImplementedError
+    if not math.isfinite(step) or step <= 0.0:
+        raise ValueError("Sampling step must be finite and positive.")
+    if puzzle not in _ROD_VERTICES:
+        raise NotImplementedError(f"Rod model for {puzzle.value} is missing.")
+
+    sections: list[NDArray[np.float64]] = []
+    directions: list[NDArray[np.float64]] = []
+    vertices = _ROD_VERTICES[puzzle]
+
+    for start, end in zip(vertices, vertices[1:]):
+        start_point = np.asarray(start, dtype=np.float64)
+        displacement = np.asarray(end, dtype=np.float64) - start_point
+        length = float(np.linalg.norm(displacement))
+        unit_tangent = displacement / length
+        sample_count = math.ceil(length / step)
+        fractions = np.linspace(0.0, 1.0, sample_count + 1)
+        section = start_point + fractions[:, np.newaxis] * displacement
+
+        if sections:
+            directions[-1][-1] = unit_tangent
+            section = section[1:]
+
+        sections.append(section)
+        directions.append(np.tile(unit_tangent, (len(section), 1)))
+
+    return (
+        PlatePoints3D(np.concatenate(sections)),
+        PlateDirections3D(np.concatenate(directions)),
+    )
