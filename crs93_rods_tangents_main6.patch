@@ -0,0 +1,229 @@
+"""Print rod samples and draw three SVG views with tangent arrows.
+
+Run from the project root: uv run python -m examples.preview_rods --puzzle B
+"""
+
+import argparse
+from pathlib import Path
+from xml.etree import ElementTree
+
+import numpy as np
+from numpy.typing import NDArray
+
+from hoop_guide.geometry import rod_to_robot_frame
+from hoop_guide.plate import PlatePose
+from hoop_guide.rods import Puzzle
+from hoop_guide.rods import rod_centerline
+
+
+_VIEW_AXES = ((0, 1, "XY"), (0, 2, "XZ"), (1, 2, "YZ"))
+
+
+def _draw_svg(
+    points: NDArray[np.float64],
+    tangents: NDArray[np.float64],
+    frame_name: str,
+    output: Path,
+) -> None:
+    """Writes an SVG containing orthogonal rod views and tangent arrows."""
+    svg = ElementTree.Element(
+        "svg",
+        {
+            "xmlns": "http://www.w3.org/2000/svg",
+            "viewBox": "0 0 1020 370",
+            "width": "1020",
+            "height": "370",
+        },
+    )
+    ElementTree.SubElement(
+        svg,
+        "rect",
+        {"width": "1020", "height": "370", "fill": "#ffffff"},
+    )
+    marker = ElementTree.SubElement(svg, "defs")
+    arrow = ElementTree.SubElement(
+        marker,
+        "marker",
+        {
+            "id": "tip",
+            "viewBox": "0 0 10 10",
+            "refX": "9",
+            "refY": "5",
+            "markerWidth": "5",
+            "markerHeight": "5",
+            "orient": "auto-start-reverse",
+        },
+    )
+    ElementTree.SubElement(
+        arrow, "path", {"d": "M 0 0 L 10 5 L 0 10 z", "fill": "#2563eb"}
+    )
+
+    for view_index, (horizontal, vertical, title) in enumerate(_VIEW_AXES):
+        origin_x = 170.0 + view_index * 340.0
+        origin_y = 180.0
+        selected = points[:, [horizontal, vertical]]
+        center = (np.max(selected, axis=0) + np.min(selected, axis=0)) / 2
+        extent = float(np.max(np.ptp(selected, axis=0)))
+        scale = 250.0 / max(extent, 0.05)
+        plotted = np.column_stack(
+            (
+                origin_x + (selected[:, 0] - center[0]) * scale,
+                origin_y - (selected[:, 1] - center[1]) * scale,
+            )
+        )
+        ElementTree.SubElement(
+            svg,
+            "rect",
+            {
+                "x": str(view_index * 340 + 12),
+                "y": "24",
+                "width": "316",
+                "height": "324",
+                "fill": "#fafafa",
+                "stroke": "#bbbbbb",
+            },
+        )
+        ElementTree.SubElement(
+            svg,
+            "text",
+            {
+                "x": str(origin_x),
+                "y": "19",
+                "font-size": "16",
+                "text-anchor": "middle",
+                "fill": "#222222",
+            },
+        ).text = f"{title} ({frame_name})"
+        ElementTree.SubElement(
+            svg,
+            "polyline",
+            {
+                "points": " ".join(
+                    f"{point[0]:.2f},{point[1]:.2f}" for point in plotted
+                ),
+                "fill": "none",
+                "stroke": "#d97706",
+                "stroke-width": "4",
+                "stroke-linejoin": "round",
+            },
+        )
+        arrow_stride = max(1, len(points) // 9)
+        bend_indices = np.flatnonzero(
+            np.linalg.norm(np.diff(tangents, axis=0), axis=1) > 1e-8
+        )
+        arrow_indices = sorted(
+            set(range(0, len(points), arrow_stride))
+            | set((bend_indices + 1).tolist())
+            | {len(points) - 1}
+        )
+        for point_index in arrow_indices:
+            direction = tangents[point_index, [horizontal, vertical]]
+            length = float(np.linalg.norm(direction))
+            if length < 1e-9:
+                continue
+            direction = direction / length
+            start_x, start_y = plotted[point_index]
+            ElementTree.SubElement(
+                svg,
+                "line",
+                {
+                    "x1": f"{start_x:.2f}",
+                    "y1": f"{start_y:.2f}",
+                    "x2": f"{start_x + direction[0] * 17:.2f}",
+                    "y2": f"{start_y - direction[1] * 17:.2f}",
+                    "stroke": "#2563eb",
+                    "stroke-width": "2",
+                    "marker-end": "url(#tip)",
+                },
+            )
+        endpoints = ((0, "#16a34a"), (len(points) - 1, "#dc2626"))
+        for point_index, color in endpoints:
+            ElementTree.SubElement(
+                svg,
+                "circle",
+                {
+                    "cx": f"{plotted[point_index, 0]:.2f}",
+                    "cy": f"{plotted[point_index, 1]:.2f}",
+                    "r": "5",
+                    "fill": color,
+                },
+            )
+
+    output.parent.mkdir(parents=True, exist_ok=True)
+    ElementTree.ElementTree(svg).write(
+        output, encoding="unicode", xml_declaration=True
+    )
+
+
+def main() -> None:
+    """Prints rod coordinates and creates an SVG with three projections."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--puzzle", choices=["A1", "A2", "B", "C"], default="B"
+    )
+    parser.add_argument("--step", type=float, default=0.005)
+    parser.add_argument(
+        "--frame", choices=["plate", "robot"], default="plate"
+    )
+    parser.add_argument("--plate-x", type=float, default=0.45)
+    parser.add_argument("--plate-y", type=float, default=0.10)
+    parser.add_argument("--plate-heading", type=float, default=0.0)
+    parser.add_argument("--plate-height", type=float, default=0.08)
+    parser.add_argument("--output", type=Path)
+    parser.add_argument(
+        "--all", action="store_true", help="Print every sample"
+    )
+    args = parser.parse_args()
+
+    points_plate, tangents_plate = rod_centerline(
+        Puzzle(args.puzzle), step=args.step
+    )
+    if args.frame == "robot":
+        points_robot, tangents_robot = rod_to_robot_frame(
+            points_plate,
+            tangents_plate,
+            PlatePose(args.plate_x, args.plate_y, args.plate_heading),
+            args.plate_height,
+        )
+        points = np.asarray(points_robot)
+        tangents = np.asarray(tangents_robot)
+    else:
+        points = np.asarray(points_plate)
+        tangents = np.asarray(tangents_plate)
+
+    output = args.output or Path(f"preview_{args.puzzle}_{args.frame}.svg")
+    _draw_svg(points, tangents, args.frame, output)
+    differences = np.linalg.norm(np.diff(points, axis=0), axis=1)
+    bend_indices = np.flatnonzero(
+        np.linalg.norm(np.diff(tangents, axis=0), axis=1) > 1e-8
+    ) + 1
+    selected_indices = (
+        range(len(points))
+        if args.all
+        else sorted({0, len(points) - 1} | set(bend_indices.tolist()))
+    )
+
+    print(
+        f"Puzzle: {args.puzzle} | Frame: {args.frame} "
+        f"| Samples: {len(points)}"
+    )
+    print(f"Centerline length: {differences.sum():.4f} m")
+    print("Index | x [m]   y [m]   z [m]   | tx       ty       tz")
+    for index in selected_indices:
+        x, y, z = points[index]
+        tx, ty, tz = tangents[index]
+        print(
+            f"{index:5d} | {x:+.4f} {y:+.4f} {z:+.4f} | "
+            f"{tx:+.4f} {ty:+.4f} {tz:+.4f}"
+        )
+    print(f"Bend indices: {bend_indices.tolist()}")
+    print(f"SVG preview: {output.resolve()}")
+    if args.frame == "robot":
+        print(
+            "NOTE: Default robot-frame plate pose is illustrative, "
+            "not measured."
+        )
+
+
+if __name__ == "__main__":
+    main()
